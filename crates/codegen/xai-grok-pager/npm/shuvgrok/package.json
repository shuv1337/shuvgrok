{
    "name": "@shuv1337/shuvgrok",
    "version": "1.0.6",
    "description": "ShuvGrok: bring Grok into your terminal",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/shuv1337/shuvgrok.git"
    },
    "bin": {
