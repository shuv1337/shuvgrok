        "@shuv1337/shuvgrok-darwin-x64": "1.0.6",
        "@shuv1337/shuvgrok-linux-arm64": "1.0.6",
        "@shuv1337/shuvgrok-linux-x64": "1.0.6",
        "@shuv1337/shuvgrok-win32-arm64": "1.0.6",
        "@shuv1337/shuvgrok-win32-x64": "1.0.6"
    }
}
